APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SSL Commerz. SSLCOMMERZ_* is preferred; SSLC_* is the package fallback.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_CURRENCY=BDT
SSLCOMMERZ_ALLOW_LOCALHOST=true

SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_STORE_CURRENCY=BDT
SSLC_ROUTE_SUCCESS=payment.success
SSLC_ROUTE_FAILURE=payment.failure
SSLC_ROUTE_CANCEL=payment.cancel
SSLC_ROUTE_IPN=payment.ipn
SSLC_ALLOW_LOCALHOST=true
SSLC_SANDBOX=true


# ---------------------------------------------------------------------------
# SSL Commerz — dgvai/laravel-sslcommerz
# Prefer SSLCOMMERZ_* below. Package-style SSLC_* also work as fallbacks.
# ---------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_CURRENCY=BDT
SSLCOMMERZ_ALLOW_LOCALHOST=true

SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_STORE_CURRENCY=BDT
SSLC_ROUTE_SUCCESS=payment.success
SSLC_ROUTE_FAILURE=payment.failure
SSLC_ROUTE_CANCEL=payment.cancel
SSLC_ROUTE_IPN=payment.ipn
SSLC_ALLOW_LOCALHOST=true
SSLC_PAYMENT_VERIFY_TEST=https://sandbox.sslcommerz.com/validator/api/merchantTransIDvalidationAPI.php
SSLC_PAYMENT_VERIFY_LIVE=https://securepay.sslcommerz.com/validator/api/merchantTransIDvalidationAPI.php
# SSLC_SANDBOX=true